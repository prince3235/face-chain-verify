# --- Server ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Search ---
CONSENT_REGISTRY_PATH=data/consented_dataset/registry.json
SIMILARITY_THRESHOLD=0.75

# --- Blockchain ---
# "simulate" writes to a local JSON ledger (no real chain, no cost, no keys needed)
# "testnet" submits real transactions via web3.py — requires the vars below
CHAIN_MODE=simulate
SIMULATED_LEDGER_PATH=data/simulated_ledger.json

RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
NETWORK_NAME=Polygon Amoy Testnet
BLOCK_EXPLORER_BASE_URL=https://amoy.polygonscan.com/tx/
